{
  "$schema": "./node_modules/@komari-monitor/plugin-sdk/schema/komari-plugin.schema.json",
  "name": {
    "zh-CN": "Komari Disky",
    "en": "Komari Disky"
  },
  "short": "disky",
  "description": {
    "zh-CN": "接收并展示来自 Komari Disky Agent 的资源快照与拓扑。",
    "en": "Receives and presents resource snapshots and topology from Komari Disky Agent."
  },
  "author": "Komari Disky contributors",
  "version": "0.1.0-rc.6",
  "komari": ">=1.4.0",
  "entry": "script.js",
  "permissions": {
    "node": true,
    "allowRoutes": true,
    "allowSystemRPC": true,
    "maxHTTPBodyBytes": 4194304,
    "timeout": 10
  },
  "configuration": {
    "type": "managed",
    "data": [
      {
        "key": "default_ttl_seconds",
        "name": {
          "zh-CN": "默认快照 TTL（秒）",
          "en": "Default snapshot TTL (seconds)"
        },
        "type": "number",
        "default": 300,
        "required": true,
        "help": {
          "zh-CN": "Agent 未指定 TTL 时使用。有效范围为 30 至 86400 秒。",
          "en": "Used when the agent omits TTL. Valid range: 30 to 86400 seconds."
        }
      }
    ]
  },
  "pages": [
    {
      "file": "pages/index.html",
      "title": {
        "zh-CN": "Disky 资源",
        "en": "Disky Resources"
      },
      "visibility": "public"
    }
  ]
}
